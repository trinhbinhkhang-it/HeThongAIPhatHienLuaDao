<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — flat pastel mint, light only. -->
    <style name="Theme.DeepCheck" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/bg_page</item>

        <!-- Primary: pastel mint -->
        <item name="colorPrimary">@color/mint_500</item>
        <item name="colorPrimaryVariant">@color/mint_600</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Secondary / accent: terracotta -->
        <item name="colorSecondary">@color/terracotta</item>
        <item name="colorSecondaryVariant">@color/terracotta_deep</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_page</item>

        <!-- Global flat overrides -->
        <item name="materialButtonStyle">@style/Widget.DeepCheck.Button.Pill</item>
        <item name="materialCardViewStyle">@style/Widget.DeepCheck.Card</item>
    </style>
</resources>
