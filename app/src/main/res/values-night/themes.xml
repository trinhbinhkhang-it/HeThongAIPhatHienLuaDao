<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night theme mirrors light theme — spec is a light pastel system. -->
    <style name="Theme.ShieldCall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/bg_page</item>

        <item name="colorPrimary">@color/mint_500</item>
        <item name="colorPrimaryVariant">@color/mint_600</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <item name="colorSecondary">@color/terracotta</item>
        <item name="colorSecondaryVariant">@color/terracotta_deep</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_page</item>

        <item name="materialButtonStyle">@style/Widget.ShieldCall.Button.Pill</item>
        <item name="materialCardViewStyle">@style/Widget.ShieldCall.Card</item>
    </style>
</resources>
