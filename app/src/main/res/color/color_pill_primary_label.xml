<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary pill label. Pairs with @color/color_pill_primary, which already paints the fill
  surface_alt while disabled: white on surface_alt would be unreadable, so the disabled label
  drops to text_disabled with it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_disabled"/>
    <item android:color="@color/text_on_primary"/>
</selector>