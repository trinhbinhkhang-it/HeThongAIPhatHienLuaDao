<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     SafeCallsCT - Hidden developer page
     Reached only by triple-tapping "Version 1.0.1" on Page 1.
     Edits the random roll windows the bubble waits before it
     shows a scan popup. Same header pattern and design tokens as
     Pages 1 and 2; no inline hex anywhere.
     ============================================================ -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- ===== Header: logo tile + wordmark ===== -->
    <LinearLayout
        android:id="@+id/app_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginEnd="@dimen/screen_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/logo_tile"
            android:layout_height="@dimen/logo_tile"
            android:background="@drawable/bg_app_logo"
            android:contentDescription="@string/app_name"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_shield"
            app:tint="@color/text_on_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.SafeCallsCT.Title"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/hidden_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xxl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxl"
            android:layout_marginEnd="@dimen/space_xxl"
            android:background="@drawable/bg_status_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/hidden_settings_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hidden_settings_title"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Headline"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/hidden_settings_subtitle"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/terracotta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/hidden_settings_intro"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                android:textColor="@color/text_secondary" />

            <!-- ===== Frame-analysis rate (performance) ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_sampling"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/hidden_sampling_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_sampling_fps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLength="4"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/sampling_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_badge_mint"
                android:padding="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/ink_on_mint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/hidden_sampling_notice"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_debug_frames_title"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/hidden_debug_frames_summary"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_debug_frames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/hidden_debug_frames_title" />
            </LinearLayout>

            <!-- ===== Frame source (screen-recorder coexistence) ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_capture_backend"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_capture_accessibility_title"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/hidden_capture_accessibility_summary"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_capture_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/hidden_capture_accessibility_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/capture_backend_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_badge_mint"
                android:padding="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/ink_on_mint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_accessibility_settings"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_open_accessibility_settings"
                android:textColor="@color/text_secondary" />

            <!-- ===== Safe Mode roll window ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_safe"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="@string/hidden_hint_min">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_safe_min"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hidden_hint_max">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_safe_max"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===== Warning Mode roll window ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/hidden_section_warning"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="@string/hidden_hint_min">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_warning_min"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hidden_hint_max">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_warning_max"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===== Live preview of the sanitised windows ===== -->
            <TextView
                android:id="@+id/hidden_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_badge_mint"
                android:padding="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/ink_on_mint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/hidden_bounds_notice"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/text_secondary" />

            <!-- ===== Face-recognition gate ("Chế độ nhận diện khuôn mặt") ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_detection"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_face_gate_title"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/hidden_face_gate_summary"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_face_gate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/hidden_face_gate_title" />
            </LinearLayout>

            <!-- ===== developer_setting_page.md §1-§3 and §7 =====
                 Four single-choice groups. RadioButtons are direct children of their
                 RadioGroup so that checking one unchecks the rest, which is what makes
                 "exactly one opening method" and "at most one automatic method" true in
                 the UI and not only in the stored enum. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_entry"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <RadioGroup
                android:id="@+id/group_scan_mode_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_entry_single_click"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_entry_single_click"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_entry_press_hold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_entry_press_hold"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_entry_press_hold_swipe_up"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_entry_press_hold_swipe_up"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_hold_duration"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <RadioGroup
                android:id="@+id/group_hold_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_hold_half_second"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_hold_half_second"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_hold_one_second"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_hold_one_second"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_hold_two_seconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_hold_two_seconds"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/hidden_hold_duration_note"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_auto_mode"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <RadioGroup
                android:id="@+id/group_auto_mode_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_auto_disabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_auto_disabled"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_auto_swipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_auto_swipe"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_auto_bubble_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_auto_bubble_position"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_feedback"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <RadioGroup
                android:id="@+id/group_mode_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_feedback_disabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_feedback_disabled"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_feedback_toast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_feedback_toast"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_feedback_toast_vibration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/mint_500"
                    android:minHeight="@dimen/chip_height"
                    android:text="@string/hidden_feedback_toast_vibration"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/hidden_interaction_note"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/text_secondary" />

            <!-- ===== Result disclaimer shown after each detection =====
                 A short toast that appears once a Safe- or Warning-mode scan produces its
                 result. The switch turns it on/off; the field below edits the text and is
                 only editable while the switch is on. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_disclaimer"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_disclaimer_title"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/hidden_disclaimer_summary"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_result_disclaimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/hidden_disclaimer_title" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/hidden_disclaimer_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_result_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save (primary pill) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hidden_save"
                style="@style/Widget.SafeCallsCT.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/btn_hidden_save"
                android:textColor="@color/text_on_primary" />

            <!-- Restore the spec defaults (outline pill) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hidden_reset"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_hidden_reset"
                android:textColor="@color/text_secondary" />

            <!-- Back (outline pill) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hidden_back"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_hidden_back"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
