<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     SafeCallsCT - Personal information page
     Reached from the top-right person icon on Page 1. Same header
     pattern and design tokens as the other pages; no inline hex.
     ============================================================ -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- ===== Header: logo tile + wordmark ===== -->
    <LinearLayout
        android:id="@+id/app_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginEnd="@dimen/screen_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/logo_tile"
            android:layout_height="@dimen/logo_tile"
            android:background="@drawable/bg_app_logo"
            android:contentDescription="@string/app_name"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_shield"
            app:tint="@color/text_on_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.SafeCallsCT.Title"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xxl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxl"
            android:layout_marginEnd="@dimen/space_xxl"
            android:background="@drawable/bg_status_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/profile_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_title"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Headline"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/profile_intro"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:hint="@string/profile_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName"
                    android:maxLength="60"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/profile_note"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/text_secondary" />

            <!-- ===== Discord webhook alert mirror =====
                 The URL a Warning-mode high-risk result is POSTed to as a rich embed
                 (metadata only). The switch arms it; "Test" sends a sample embed to the
                 URL currently in the field, even while the switch is off. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_discord"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_discord_title"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/hidden_discord_summary"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_discord_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/hidden_discord_title" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/hidden_discord_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_discord_webhook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_discord_test"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_discord_test"
                android:textColor="@color/text_secondary" />

            <!-- Screenshot option: only shown while the Discord mirror is armed. -->
            <LinearLayout
                android:id="@+id/discord_screenshot_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_discord_screenshot_title"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/hidden_discord_screenshot_summary"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_discord_screenshot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/hidden_discord_screenshot_title" />
            </LinearLayout>

            <!-- ===== Zalo Bot alert channel =====
                 Outbound Zalo is Bot Token + chat_id (there is no webhook URL for sending).
                 The switch arms it; "Test" sends a sample message to the entered token/id. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/hidden_section_zalo"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.Label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hidden_zalo_title"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/hidden_zalo_summary"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_zalo_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@string/hidden_zalo_title" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/hidden_zalo_token_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_zalo_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zalo_fetch_id"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_zalo_fetch_id"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/hidden_zalo_group_note"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hidden_zalo_add_id_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_zalo_add_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SafeCallsCT.Body"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_zalo_add_id"
                    style="@style/Widget.SafeCallsCT.Button.PillOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_pill"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/btn_zalo_add_id"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/zalo_recipients_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/hidden_zalo_recipients_empty"
                android:textAppearance="@style/TextAppearance.SafeCallsCT.BodySmall"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/zalo_recipient_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zalo_clear_recipients"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_zalo_clear_recipients"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zalo_test"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_zalo_test"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_reset"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/btn_profile_reset"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_save"
                style="@style/Widget.SafeCallsCT.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/btn_profile_save"
                android:textColor="@color/text_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_back"
                style="@style/Widget.SafeCallsCT.Button.PillOutline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_pill"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/btn_profile_back"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
